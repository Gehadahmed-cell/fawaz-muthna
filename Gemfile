# تثبيت نسخة Jekyll التي يُبنى بها الموقع.
#
# قبل هذا الملف كان GitHub Pages يبني بـ Jekyll 3.10 عبر حزمة github-pages،
# بينما الاختبار المحلي يجري على 4.x — فجوة لا تظهر إلا بعد النشر.
# الآن ملف .github/workflows/pages.yml يبني بهذه النسخة بالضبط،
# فما يُختبر محلياً هو ما يُنشر حرفياً.
source "https://rubygems.org"

gem "jekyll", "4.4.1"

# لا إضافات (plugins): الموقع لا يستعمل أياً منها، وتركه بلا إضافات
# يبقيه قابلاً للبناء بـ `jekyll build` مباشرة دون bundler.
